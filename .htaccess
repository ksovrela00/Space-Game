# Отключение кеша для исходников игры.
#
# Зачем. Игра — это ES-модули, которые импортируют друг друга по
# относительным путям. Добавить версию к одному тегу <script> нельзя:
# обновится только точка входа, а остальные тридцать файлов браузер
# возьмёт из кеша — и страница поедет на смеси нового и старого кода.
# Это худший из возможных исходов: не «старая версия», а версия,
# которой никогда не существовало.
#
# Поэтому кеш выключается на сервере, для всего сразу. Правило на месте
# ровно потому, что игра раздаётся статикой: тут нет сборки, которая
# проставила бы хеши в имена файлов.
#
# Цена: каждая перезагрузка тянет исходники заново. Для разработки это
# и требуется. Для раздачи наружу правило стоит заменить на обычное
# кеширование с версией в имени файла.

<IfModule mod_headers.c>
  <FilesMatch "\.(js|mjs|css|html|json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
    # ETag и Last-Modified тоже убираем: с ними браузер шлёт условный
    # запрос и на «304 Не изменилось» продолжает пользоваться старым
    # файлом — а именно этого мы и избегаем.
    Header unset ETag
    Header unset Last-Modified
  </FilesMatch>
</IfModule>

FileETag None

# Звук и модели, наоборот, кешировать НУЖНО: они не меняются, а весят
# на три порядка больше кода.
<IfModule mod_headers.c>
  <FilesMatch "\.(mp3|ogg|wav|png|jpg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
